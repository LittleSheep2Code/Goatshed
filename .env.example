NUXT_PUBLIC_API_BASE_URL=https://api.solian.app

# OAuth provider display name
NUXT_PUBLIC_OAUTH_PROVIDER_NAME=Solarpass

# Database (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goatshed

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OIDC Provider (Solarpass / Solian)
SOLIAN_CLIENT_ID=
SOLIAN_CLIENT_SECRET=

# Solian custom app (wallet orders + board widgets; use app UUID for Develop private routes)
SOLIAN_APP_CLIENT_ID=
SOLIAN_APP_SECRET=

# Optional: pin board widget keys
# Mood: image + mood
# Working/tasks: image + background + tasks
# Profile: image + background + data (dict, max 6 K-V)
# MOOD_WIDGET_KEY=littlesheep_mood
# WORKING_WIDGET_KEY=working
# PROFILE_WIDGET_KEY=profile

# Admin emails (comma-separated). Users with these emails are auto-promoted to admin.
ADMIN_EMAILS=

# Last.fm API key (https://www.last.fm/api/account/create). Without it the about
# page's music section does not render.
NUXT_LASTFM_API_KEY=

# Last.fm account the music section reads.
NUXT_PUBLIC_LASTFM_USER=LittleSheepOvO

# Optional: stable secret for signed OG image URLs (nuxt-og-image).
# Without it every build mints a new secret, so URLs change on each deploy and
# unfurlers re-fetch; required for rolling/multi-instance deploys.
# Generate with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=
